---
import { NAV } from '../data/site';

interface Props {
  path: string;
}

const { path } = Astro.props;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Astrae Oratio Wiki — home">
      <svg class="brand-star" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 1.5l2.4 7.1 7.1 2.4-7.1 2.4L12 20.5l-2.4-7.1L2.5 11l7.1-2.4z" fill="currentColor"></path>
      </svg>
      <span class="brand-name">Astrae Oratio</span>
      <span class="brand-tag">Wiki</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {
        NAV.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="bar-tools">
      <button class="theme-toggle" type="button" aria-label="Toggle light / dark theme" title="Toggle theme">
        <svg viewBox="0 0 24 24" aria-hidden="true" class="i-moon"
          ><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor"></path></svg
        >
        <svg viewBox="0 0 24 24" aria-hidden="true" class="i-sun"
          ><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><g stroke="currentColor" stroke-width="2" stroke-linecap="round"
            ><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
            ></path></g
          ></svg
        >
      </button>

      <details class="nav-mobile">
        <summary aria-label="Open menu">
          <span></span><span></span><span></span>
        </summary>
        <nav aria-label="Mobile">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href="/factions/">Factions</a>
          <a href="/glossary/">Glossary</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    const next = current === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 3.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text);
    flex: none;
  }

  .brand:hover {
    color: var(--text);
  }

  .brand-star {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--gold);
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .brand-tag {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent);
    border-radius: 4px;
    padding: 0.12rem 0.35rem;
  }

  .nav-desktop {
    display: none;
    gap: 0.2rem;
    margin-left: auto;
  }

  .nav-desktop a,
  .nav-mobile nav a {
    color: var(--text-dim);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.95rem;
    padding: 0.4rem 0.65rem;
    border-radius: 8px;
  }

  .nav-desktop a:hover,
  .nav-mobile nav a:hover {
    color: var(--text);
    background: var(--surface);
  }

  .nav-desktop a[aria-current='page'],
  .nav-mobile nav a[aria-current='page'] {
    color: var(--gold);
  }

  .bar-tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
  }

  .theme-toggle,
  .nav-mobile summary {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text-dim);
    cursor: pointer;
  }

  .theme-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .theme-toggle .i-sun {
    display: none;
  }

  :global([data-theme='light']) .theme-toggle .i-sun {
    display: block;
  }

  :global([data-theme='light']) .theme-toggle .i-moon {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .theme-toggle .i-sun {
      display: block;
    }

    :global(:root:not([data-theme='dark'])) .theme-toggle .i-moon {
      display: none;
    }
  }

  .nav-mobile {
    position: relative;
  }

  .nav-mobile summary {
    list-style: none;
    gap: 3px;
    align-content: center;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile summary span {
    display: block;
    width: 1.05rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.6rem);
    display: grid;
    min-width: 13rem;
    padding: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  @media (min-width: 1020px) {
    .nav-desktop {
      display: flex;
    }

    .bar-tools {
      margin-left: 0;
    }

    .nav-mobile {
      display: none;
    }
  }
</style>
