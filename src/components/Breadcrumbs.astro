---
import type { Crumb } from '../layouts/Base.astro';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    {
      items.map((c, i) =>
        i < items.length - 1 ? (
          <li>
            <a href={c.href}>{c.name}</a>
          </li>
        ) : (
          <li aria-current="page">{c.name}</li>
        ),
      )
    }
  </ol>
</nav>
