---
// A deterministic "star sign" for each character, generated from a seed string.
// Original artwork for the site (no official assets): same seed -> same constellation.

interface Props {
  seed: string;
  color: string;
  size?: number;
  class?: string;
}

const { seed, color, size = 120, class: className } = Astro.props;

function hash(str: string) {
  let h = 0x811c9dc5;
  for (let i = 0; i < str.length; i++) {
    h ^= str.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return h >>> 0;
}

function rng(seedNum: number) {
  let a = seedNum;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = rng(hash(seed));
const count = 5 + Math.floor(rand() * 3);
const stars: { x: number; y: number; r: number }[] = [];
for (let i = 0; i < count; i++) {
  let best = { x: 50, y: 50 };
  for (let attempt = 0; attempt < 40; attempt++) {
    const ang = rand() * Math.PI * 2;
    const dist = 8 + Math.sqrt(rand()) * 26;
    const cand = { x: 50 + Math.cos(ang) * dist, y: 50 + Math.sin(ang) * dist };
    const ok = stars.every((s) => Math.hypot(s.x - cand.x, s.y - cand.y) > 13);
    best = cand;
    if (ok) break;
  }
  stars.push({ ...best, r: 1.1 + rand() * 1.5 });
}

// Chain stars by nearest neighbour for a readable constellation line.
const order = [0];
const left = new Set(stars.map((_, i) => i).slice(1));
while (left.size) {
  const last = stars[order[order.length - 1]];
  let pick = -1;
  let d = Infinity;
  for (const i of left) {
    const dd = Math.hypot(stars[i].x - last.x, stars[i].y - last.y);
    if (dd < d) {
      d = dd;
      pick = i;
    }
  }
  order.push(pick);
  left.delete(pick);
}
const path = order.map((i, k) => `${k ? 'L' : 'M'}${stars[i].x.toFixed(2)} ${stars[i].y.toFixed(2)}`).join(' ');
const bright = stars[order[Math.floor(rand() * order.length)]];
const sparkle = (x: number, y: number, s: number) =>
  `M${x} ${y - s} L${x + s * 0.28} ${y - s * 0.28} L${x + s} ${y} L${x + s * 0.28} ${y + s * 0.28} L${x} ${y + s} L${x - s * 0.28} ${y + s * 0.28} L${x - s} ${y} L${x - s * 0.28} ${y - s * 0.28} Z`;
const ticks = Array.from({ length: 24 }, (_, i) => {
  const a = (i / 24) * Math.PI * 2;
  const r1 = i % 6 === 0 ? 41.5 : 43;
  return `M${(50 + Math.cos(a) * r1).toFixed(2)} ${(50 + Math.sin(a) * r1).toFixed(2)} L${(50 + Math.cos(a) * 45).toFixed(2)} ${(50 + Math.sin(a) * 45).toFixed(2)}`;
}).join(' ');
---

<svg
  class:list={['sigil', className]}
  viewBox="0 0 100 100"
  width={size}
  height={size}
  aria-hidden="true"
  style={`--sig:${color}`}
>
  <circle cx="50" cy="50" r="47" fill="none" stroke="var(--sig)" stroke-opacity="0.55" stroke-width="0.8"></circle>
  <circle cx="50" cy="50" r="39.5" fill="none" stroke="var(--sig)" stroke-opacity="0.3" stroke-width="0.5" stroke-dasharray="1.2 2.2"></circle>
  <path d={ticks} stroke="var(--sig)" stroke-opacity="0.6" stroke-width="0.7"></path>
  <path d={path} fill="none" stroke="var(--sig)" stroke-opacity="0.75" stroke-width="0.7" stroke-linejoin="round"></path>
  {stars.map((s) => <circle cx={s.x.toFixed(2)} cy={s.y.toFixed(2)} r={s.r.toFixed(2)} fill="var(--sig)" />)}
  <path d={sparkle(bright.x, bright.y, 5.2)} fill="var(--sig)"></path>
</svg>
